# Copy to docker/.env and fill in. EULA=true means you accept https://aka.ms/MinecraftEULA
EULA=false
PACK_DIR=C:/path/to/folder/with/GT_New_Horizons_2.8.4_Server_Java_17-25.zip
BRIDGE_TOKENS=C:/Users/you/.moddedbench
SERVER_MEMORY_MIB=6144
# true turns off the pack's pitch-black night rendering (Darkerer) for recording; gameplay light levels are unchanged
BRIGHT_NIGHTS=false
# The chat bot (docker compose --profile chat). The bot's own Twitch account, the channel it answers in, and that account's chat token.
TWITCH_CHANNEL=
TWITCH_NICK=
TWITCH_TOKEN=
