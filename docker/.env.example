# Copy to docker/.env and fill in. EULA=true means you accept https://aka.ms/MinecraftEULA
EULA=false
# The folder that holds GT_New_Horizons_2.8.4_Server_Java_17-25.zip, not the zip itself
PACK_DIR=C:/path/to/folder
# Create this folder if it is missing; the client writes its token file there
BRIDGE_TOKENS=C:/Users/you/.moddedbench
SERVER_MEMORY_MIB=6144
# true turns off the pack's pitch-black night rendering (Darkerer) for recording; gameplay light levels are unchanged
BRIGHT_NIGHTS=false
# World difficulty, written to server.properties at every server start: 0 peaceful, 1 easy, 2 normal, 3 hard (the pack ships 3)
MB_DIFFICULTY=1
# The agent CLIs are normally logged in once inside the agent container (docs/CONTAINERS.md, step 4) and need nothing here.
# A key or token instead of a login: remove the # and fill in the one you use. Never leave one uncommented and empty.
# CLAUDE_CODE_OAUTH_TOKEN=   (Claude Code, subscription: the token `claude setup-token` prints)
# ANTHROPIC_API_KEY=         (Claude Code, API billing)
# CODEX_API_KEY=             (Codex, API billing)
